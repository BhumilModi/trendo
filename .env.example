# All optional for local dev. Without them the app uses a local SQLite file
# (local.db) and the pre-written stories in content/fallback.json.

# Turso database (required in production; Vercel's filesystem is not persistent)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Daily story generation (free key from https://aistudio.google.com)
GEMINI_API_KEY=
# Default tries gemini-3.6-flash, then 3.8-flash, then flash-latest if one is overloaded.
# Set this to pin one model.
# GEMINI_MODEL=gemini-3.6-flash

# Protects /api/cron/generate. Vercel Cron sends it automatically.
CRON_SECRET=
